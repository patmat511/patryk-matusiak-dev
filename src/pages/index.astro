---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="max-w-2xl mx-auto px-6 py-8">
    
    <!-- NAV -->
    <nav class="flex justify-end gap-7 py-8 mb-20">
      <a href="/projects" class="text-sm text-stone-400 hover:text-stone-50 transition-colors">projekty</a>
      <a href="/blog" class="text-sm text-stone-400 hover:text-stone-50 transition-colors">blog</a>
      <a href="/about" class="text-sm text-stone-400 hover:text-stone-50 transition-colors">o mnie</a>
    </nav>
    
    <!-- HERO -->
    <header class="mb-24">
      <h1 class="text-3xl font-bold tracking-tight mb-3">Patryk Matusiak</h1>
      <p class="font-mono text-sm text-stone-400 mb-7">ML Engineer · Bielsko-Biała</p>
      <p class="text-stone-400 mb-4">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. 
        Buduję systemy ML w produkcji, skupiam się na LLM, RAG i fine-tuningu.
      </p>
      <p class="text-stone-400">
        Aktualnie student magisterki AI. Lorem ipsum dolor sit amet.
      </p>
      <div class="flex gap-6 mt-9 text-sm">
        <a href="#" class="text-stone-50 border-b border-stone-600 hover:border-stone-50 transition-colors pb-0.5">github →</a>
        <a href="#" class="text-stone-50 border-b border-stone-600 hover:border-stone-50 transition-colors pb-0.5">linkedin →</a>
        <a href="#" class="text-stone-50 border-b border-stone-600 hover:border-stone-50 transition-colors pb-0.5">cv.pdf →</a>
        <a href="#" class="text-stone-50 border-b border-stone-600 hover:border-stone-50 transition-colors pb-0.5">email →</a>
      </div>
    </header>
    
    <!-- PROJECTS -->
    <section class="mb-20">
      <p class="font-mono text-xs uppercase tracking-wider text-stone-400 mb-8 pb-3 border-b border-stone-800">
        Wybrane projekty
      </p>
      
      <a href="#" class="block py-7 border-b border-stone-800 hover:pl-2 transition-all">
        <div class="flex justify-between items-baseline mb-3">
          <h3 class="font-mono text-base font-medium">lorem-ipsum-project</h3>
          <span class="font-mono text-xs text-stone-400">2026</span>
        </div>
        <p class="text-sm text-stone-400 mb-4 leading-relaxed">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
        </p>
        <div class="flex flex-wrap gap-1.5">
          <span class="font-mono text-xs text-stone-400 bg-stone-900 px-2 py-1 rounded">PyTorch</span>
          <span class="font-mono text-xs text-stone-400 bg-stone-900 px-2 py-1 rounded">FastAPI</span>
          <span class="font-mono text-xs text-stone-400 bg-stone-900 px-2 py-1 rounded">AWS</span>
        </div>
      </a>
      
      <a href="#" class="block py-7 border-b border-stone-800 hover:pl-2 transition-all">
        <div class="flex justify-between items-baseline mb-3">
          <h3 class="font-mono text-base font-medium">another-project</h3>
          <span class="font-mono text-xs text-stone-400">2025</span>
        </div>
        <p class="text-sm text-stone-400 mb-4 leading-relaxed">
          Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
        </p>
        <div class="flex flex-wrap gap-1.5">
          <span class="font-mono text-xs text-stone-400 bg-stone-900 px-2 py-1 rounded">Python</span>
          <span class="font-mono text-xs text-stone-400 bg-stone-900 px-2 py-1 rounded">Docker</span>
        </div>
      </a>
      
      <a href="#" class="block py-7 hover:pl-2 transition-all">
        <div class="flex justify-between items-baseline mb-3">
          <h3 class="font-mono text-base font-medium">third-project</h3>
          <span class="font-mono text-xs text-stone-400">2025</span>
        </div>
        <p class="text-sm text-stone-400 mb-4 leading-relaxed">
          Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.
        </p>
        <div class="flex flex-wrap gap-1.5">
          <span class="font-mono text-xs text-stone-400 bg-stone-900 px-2 py-1 rounded">React</span>
          <span class="font-mono text-xs text-stone-400 bg-stone-900 px-2 py-1 rounded">TypeScript</span>
        </div>
      </a>
    </section>
    
    <!-- WRITING -->
    <section class="mb-20">
      <p class="font-mono text-xs uppercase tracking-wider text-stone-400 mb-8 pb-3 border-b border-stone-800">
        Ostatnie wpisy
      </p>
      
      <a href="#" class="flex justify-between items-baseline gap-4 py-4 border-b border-stone-800 hover:pl-2 transition-all">
        <span class="text-sm font-medium">Lorem ipsum dolor sit amet consectetur</span>
        <span class="font-mono text-xs text-stone-400 shrink-0">2026-04-12</span>
      </a>
      
      <a href="#" class="flex justify-between items-baseline gap-4 py-4 border-b border-stone-800 hover:pl-2 transition-all">
        <span class="text-sm font-medium">Sed do eiusmod tempor incididunt</span>
        <span class="font-mono text-xs text-stone-400 shrink-0">2026-03-08</span>
      </a>
      
      <a href="#" class="flex justify-between items-baseline gap-4 py-4 hover:pl-2 transition-all">
        <span class="text-sm font-medium">Ut labore et dolore magna aliqua</span>
        <span class="font-mono text-xs text-stone-400 shrink-0">2026-02-19</span>
      </a>
    </section>
    
    <!-- NOW -->
    <section class="mb-20">
      <p class="font-mono text-xs uppercase tracking-wider text-stone-400 mb-8 pb-3 border-b border-stone-800">
        Teraz
      </p>
      <p class="text-stone-400 mb-4">
        <span class="text-stone-50 font-semibold">Maj 2026.</span> Lorem ipsum dolor sit amet, consectetur adipiscing elit.
      </p>
      <p class="text-stone-400">
        Ut enim ad minim veniam. Otwarty na rozmowy o pozycjach Junior ML Engineer.
      </p>
    </section>
    
  </div>
  
  <!-- FOOTER -->
  <footer class="max-w-2xl mx-auto px-6 py-12 border-t border-stone-800 flex justify-between font-mono text-xs text-stone-400">
    <span>© 2026 Patryk Matusiak</span>
    <span>built with astro</span>
  </footer>
</Layout>